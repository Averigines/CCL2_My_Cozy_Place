<%- contentFor('includeStyles') %>
<link rel ="stylesheet" href="/styles/styleRegister.css">

<%- contentFor('body') %>
<div id = wrapper">
    <div id = "formEditUser">
        <h1>Change your data</h1>
        <form action = '/users/<%= user.UID%>/editProfile' method = 'post'>
            <div class = 'form_part'>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>mail</i>
                        <input type = 'text' name = 'email' value = "<%= user.email%>" placeholder = 'E-Mail address' required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>person</i>
                        <input type = 'text' name = 'username' value = "<%= user.username%>" placeholder = 'Username' required="required">
                    </div>
                    <hr>
                </div>
            </div>
            <div class = 'form_part'>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>lock</i>
                        <input type = 'password' name = 'oldPassword' placeholder = 'Current Password'>
                    </div>
                    <hr>
                </div>
                <p class = 'errorMsg'><%= message%></p>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>lock</i>
                        <input type = 'password' name = 'password' placeholder = 'New Password' minlength="6">
                    </div>
                    <hr>
                </div>
            </div>
            <div class = 'form_part'>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'></i>
                        <input type = 'text' name = 'firstname' value = "<%= user.firstname%>" placeholder = "First Name" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'></i>
                        <input type = 'text' name = 'lastname' value = "<%= user.lastname%>" placeholder="Last Name" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'></i>
                        <input type = 'text' name = 'country' value = "<%= user.country%>" placeholder="Country" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'></i>
                        <input type = 'text' name = 'city' value = "<%= user.city%>"placeholder="City" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'></i>
                        <input type = 'text' name = 'streetaddress' value = "<%= user.streetaddress%>" placeholder="Street Address" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element'>
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>smartphone</i>
                        <input type = 'text' name = 'phonenumber' value = "<%= user.phonenumber%>" placeholder="Phone Number" required="required">
                    </div>
                    <hr>
                </div>
                <div class = 'form_element' style = "display: none;">
                    <div class = 'form_element_upper'>
                        <i class="material-symbols-outlined" style = 'color:#818181; min-width: 32px'>smartphone</i>
                        <input type = 'text' name = 'UID' value = "<%= user.UID%>">
                    </div>
                    <hr>
                </div>
            </div>
            <input id = "submit" type="submit" value="Change data">
        </form>
    </div>
</div>