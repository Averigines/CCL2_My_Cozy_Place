<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@40,400,0,0" />
    <link href="https://fonts.googleapis.com/css?family=Mali" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Inter" rel="stylesheet">
    <link rel ="stylesheet" href="/styleAll.css">
    <link rel ="stylesheet" href="/styleItem.css">
    <title>Document</title>
</head>
<body>
<nav id = "topbar">
    <ul id = "top_left">
        <li><a onclick = "document.location.href = '/'">my cozy place</a></li>
    </ul>
    <ul id = "top_middle">
        <li>
            <input id = 'search_bar' type = 'text' name = 'search_bar' placeholder="Search for articles">
            <i id = "searchIcon" class="material-symbols-outlined">search</i>
        </li>
    </ul>
    <ul id = "top_right">
        <% if(user) { %>
            <% if(user.imageuuid != null) {%>
                <li><img id = 'avatarNav' src = '/uploads/<%= user.imageuuid%>' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
            <%}
            else {%>
                <li><img id = 'avatarNav' src = '/uploads/example-avatar.jpg' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
        <%}}
        else { %>
            <li><a onclick = "document.location.href = '/login'">Login</a></li>
        <%}%>
        <% if(user) { %>
            <li><a onclick = "document.location.href = '/logout'">Logout</a></li>
        <%}
        else {%>
            <li><a onclick = "document.location.href = '/register'">Register</a></li>
        <%}%>

        <li><i id = "shopping_cart" class="material-symbols-outlined">shopping_cart</i></li>
    </ul>
</nav>
<nav id = "navbar">
    <ul>
        <li><a>Knitting</a></li>
        <li><a>Stitching</a></li>
        <li><a>Woodwork</a></li>
        <li><a>Pottery</a></li>
        <li><a>More</a></li>
    </ul>
</nav>
<div id = "wrapper">
    <div class = "section">
        <div class = "subsection">
            <div class = "subsection_left">
                <div class = "divItemImageContainer">
                    <div class = "divItemImageBig">
                        <img class = "itemImageBig" src = "/uploads/<%= item.imageuuid1%>">
                    </div>
                    <div class = "itemSlider">
                        <%
                            let images = [];
                            if(item.imageuuid1) images[0] = item.imageuuid1;
                            if(item.imageuuid2) images[1] = item.imageuuid2;
                            if(item.imageuuid3) images[2] = item.imageuuid3;
                            if(item.imageuuid4) images[3] = item.imageuuid4;
                            if(item.imageuuid5) images[4] = item.imageuuid5;
                            console.log(images);
                            let imageObject =  itemJSON;
                            console.log(imageObject);
                        for(let i = 0; i<images.length; i++) {%>
                                <div class ="mySlides">
                                    <div class = "imageSlides">
                                        <img class="imagesSlider" src="/uploads/<%= images[i]%>" onclick = "changeImage(<%= i%>)">
                                    </div>
                                </div>
                            <%}%>
                    </div>
                </div>
            </div>
            <div class = "subsection_right">
                <div class = "itemInfo">
                    <div class = "divItemHeader">
                        <h1 class = "itemHeader"><%= item.title%></h1>
                        <button id = "watchlist" class = "buttonMain"><i class="material-symbols-outlined" style = 'color:white; font-size: 32px'>hotel_class</i></button>
                    </div>
                    <p class = "itemDescription"><%= item.description%></p>
                </div>
                <div class = "itemaddInfo">
                    <div class = "divItemSeller">
                        <p class = "itemSeller" onclick = "document.location.href = '/users/<%= currentUser.UID%>'"><%= currentUser.firstname + ' ' + currentUser.lastname%></p>
                        <button class = "buttonMain" id = "buttonContact">Contact</button>
                    </div>

                    <div class = "itemPrice">
                        <p class = "price_big"><%= item.price%> €</p>
                        <%if(item.transfer === 0) {%>
                        <p class = "transferOptions">Pickup only</p>
                        <%} else {%>
                            <p class = "transferOptions">Transfer only</p>
                        <%}%>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changeImage(i) {
        let bigImage = document.getElementsByClassName('itemImageBig');
        let imageToChange = document.getElementsByClassName('imagesSlider');
        bigImage[0].src = `${imageToChange[i].src}`;
    }
</script>
</body>
</html>