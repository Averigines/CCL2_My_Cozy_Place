<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@40,400,0,0" />
    <link href="https://fonts.googleapis.com/css?family=Mali" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Inter" rel="stylesheet">
    <link rel ="stylesheet" href="/styleAll.css">
    <title>Document</title>
</head>
<body>
<nav id = "topbar">
    <ul id = "top_left">
        <li><a onclick = "document.location.href = '/'">my cozy place</a></li>
    </ul>
    <ul id = "top_middle">
        <li>
            <input id = 'search_bar' type = 'text' name = 'search_bar' placeholder="Search for articles">
            <i id = "searchIcon" class="material-symbols-outlined">search</i>
        </li>
    </ul>
    <ul id = "top_right">
        <% if(user) { %>
            <% if(user.imageuuid != null) {%>
                <li><img id = 'avatarNav' src = '/uploads/<%= user.imageuuid%>' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
            <%}
            else {%>
                <li><img id = 'avatarNav' src = '/uploads/example-avatar.jpg' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
        <%}}
        else { %>
            <li><a onclick = "document.location.href = '/login'">Login</a></li>
        <%}%>
        <% if(user) { %>
            <li><a onclick = "document.location.href = '/logout'">Logout</a></li>
        <%}
        else {%>
            <li><a onclick = "document.location.href = '/register'">Register</a></li>
        <%}%>

        <li><i id = "shopping_cart" class="material-symbols-outlined">shopping_cart</i></li>
    </ul>
</nav>
<nav id = "navbar">
    <ul>
        <li><a>Knitting</a></li>
        <li><a>Stitching</a></li>
        <li><a>Woodwork</a></li>
        <li><a>Pottery</a></li>
        <li><a>More</a></li>
    </ul>
</nav>

<div id = "wrapper">
    <div id = "form">
        <h1>New item</h1>
        <form action = '/users/<%= user.UID%>/new_item' method = 'post' enctype="multipart/form-data">
        <div id = "form_content">
                <div id = "form_left">
                    <div class = "form_element">
                        <label for = "title">Title</label><br>
                        <input type = 'text' id = "title" name = 'title' placeholder = 'Enter Your title, e.g.: hoodie, grey, size: L' required="required">
                    </div>
                    <div class = "form_element">
                        <label for = "description">Description</label><br>
                        <textarea id = "description" name = 'description' placeholder = 'Detailed description for your article' rows = '6' cols = 50 required="required"></textarea>
                    </div>
                </div>
                <div id = "form_right">
                    <div class = "form_element">
                        <label for = "price">Sale price in €</label><br>
                        <input type = 'number' step = "0.01" min = 0 id = "price" name = 'price' required="required">
                    </div>
                    <div class = "form_element">
                        <fieldset>
                            <legend>Transfer option</legend>
                            <input type = 'radio' id = "pickup" name = 'transfer' value = "pickup" required="required">
                            <label for = "pickup">Pickup</label>
                            <input type = 'radio' id = "shipping" name = 'transfer' value = "shipping" required="required">
                            <label for = "shipping">Shipping</label>
                        </fieldset>
                    </div>
                    <div class = "form_element">
                        <label id = "imageLabel" for = "itemImage_form">
                            <i id = "newItemImageIcon" class="material-symbols-outlined" style = 'color:#80916d; min-width: 32px'>photo</i>
                            Choose images<br/>
                            <input type="file" id="itemImage_form" name="itemImage" accept="image/png, image/jpeg" multiple>
                            <span id = "imageName"></span>
                        </label>
                    </div>
                </div>
            </div>
            <div id = "form_submit">
                <input id = "submit" type="submit" value="Publish">
            </div>
        </form>
    </div>
</div>
<script>
    let input = document.getElementById("itemImage_form");
    let imageName = document.getElementById("imageName")
    input.addEventListener("change", ()=>{
        let inputImage = [];
        console.log(inputImage);
        for(let i = 0; i < document.querySelector("input[type=file]").files.length; i++) {
            inputImage[i] = document.querySelector("input[type=file]").files[i];
            imageName.innerText = imageName.innerText + " " + inputImage[i].name;
        }

    })
</script>
</body>
</html>