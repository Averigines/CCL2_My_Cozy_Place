<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@40,400,0,0" />
    <link href="https://fonts.googleapis.com/css?family=Mali" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Inter" rel="stylesheet">
    <link rel ="stylesheet" href="/styleAll.css">
    <link rel ="stylesheet" href="/styleUser.css">
    <title>Document</title>
</head>
<body>
<nav id = "topbar">
    <ul id = "top_left">
        <li><a onclick = "document.location.href = '/'">my cozy place</a></li>
    </ul>
    <ul id = "top_middle">
        <li>
            <input id = 'search_bar' type = 'text' name = 'search_bar' placeholder="Search for articles">
            <i id = "searchIcon" class="material-symbols-outlined">search</i>
        </li>
    </ul>
    <ul id = "top_right">
        <% if(user) { %>
            <% if(user.imageuuid != null) {%>
                <li><img id = 'avatarNav' src = '/uploads/<%= user.imageuuid%>' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
            <%}
            else {%>
                <li><img id = 'avatarNav' src = '/uploads/example-avatar.jpg' onclick = "document.location.href = '/users/<%= user.UID%>'"></li>
        <%}}
        else { %>
            <li><a onclick = "document.location.href = '/login'">Login</a></li>
        <%}%>
        <% if(user) { %>
            <li><a onclick = "document.location.href = '/logout'">Logout</a></li>
        <%}
        else {%>
            <li><a onclick = "document.location.href = '/register'">Register</a></li>
        <%}%>

        <li><i id = "shopping_cart" class="material-symbols-outlined">shopping_cart</i></li>
    </ul>
</nav>
<nav id = "navbar">
    <ul>
        <li><a>Knitting</a></li>
        <li><a>Stitching</a></li>
        <li><a>Woodwork</a></li>
        <li><a>Pottery</a></li>
        <li><a>More</a></li>
    </ul>
</nav>

<div id = "wrapper">
    <div class = "section">
        <div class = "subsection">
            <div class = "subsection_left">
                <div class = "profile_User">
                    <img id = "profile_User_Picture" src = "/uploads/<%= currentUser.imageuuid%>">
                    <p class = "profileName"><%= currentUser.firstname + " " + currentUser.lastname%></p>
                    <p class = "profileCity"><%= currentUser.city + ", " + currentUser.country%></p>
                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                        <button id = "changeUserButton" class = "buttonMain" onclick = "document.location.href = '/users/<%= user.UID%>/editProfile'">Change my data</button>
                    <%}}%>
                </div>
            </div>
            <div class = "subsection_right">
                <div class = "itemsHeader">
                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                        <h1>My active items</h1>
                    <%} else {%>
                        <h1><%= currentUser.firstname%>s active items</h1>
                    <%}} else {%>
                        <h1><%= currentUser.firstname%>s active items</h1>
                    <%}%>

                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                            <button id = "newItemButton" class = "buttonMain" onclick = "document.location.href = '/users/<%= user.UID%>/new_item'">New item +</button>
                        <%}}%>
                </div>
                <div class = "divItems">
                    <%for(let i = 0; i<items.length; i++) {%>
                        <div class = "divItem">
                            <div class = "divItemPart">
                                <div class = "divItemImageSmall">
                                    <img class = "itemImageSmall" src = "/uploads/<%= items[i].imageuuid1%>">
                                </div>
                                <div class = "itemText">
                                    <p class = "itemName" onclick = "document.location.href = '/items/<%= items[i].IID%>'"><%= items[i].title%></p>
                                    <p class = "itemPrice"><%= items[i].price%> €</p>
                                </div>
                            </div>
                            <div class = "divItemPart">
                                <%if(user) {
                                if(currentUser.UID === user.UID) {%>
                                    <button class = "buttonSecondary buttonChangeItem">Change</button>
                                    <button class = "buttonDelete buttonDeleteItem" onclick = "document.location.href = '/items/<%= items[i].IID%>/deleteItem'">Delete</button>
                                <%}}%>
                            </div>
                        </div>
                    <%}%>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>