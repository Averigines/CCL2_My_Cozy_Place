<%- contentFor('includeStyles') %>
<link rel ="stylesheet" href="/styles/styleUser.css">

<%- contentFor('body') %>
<div id = "wrapper">
    <div class = "section">
        <div class = "subsection">
            <div class = "subsection_left">
                <div class = "profile_User">
                    <img id = "profile_User_Picture" src = "/uploads/<%= currentUser.imageuuid%>">
                    <p class = "profileName"><%= currentUser.firstname + " " + currentUser.lastname%></p>
                    <p class = "profileCity"><%= currentUser.city + ", " + currentUser.country%></p>
                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                        <button id = "changeUserButton" class = "buttonMain" onclick = "document.location.href = '/users/<%= user.UID%>/editProfile'">Change my data</button>
                    <%}}%>
                </div>
            </div>
            <div class = "subsection_right">
                <div class = "itemsHeader">
                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                        <h1>My active items</h1>
                    <%} else {%>
                        <h1><%= currentUser.firstname%>s active items</h1>
                    <%}} else {%>
                        <h1><%= currentUser.firstname%>s active items</h1>
                    <%}%>

                    <%if(user) {
                    if(currentUser.UID === user.UID) {%>
                            <button id = "newItemButton" class = "buttonMain" onclick = "document.location.href = '/users/<%= user.UID%>/new_item'">New item +</button>
                        <%}}%>
                </div>
                <div class = "divItems">
                    <%for(let i = 0; i<items.length; i++) {%>
                        <div class = "divItem">
                            <div class = "divItemPart">
                                <div class = "divItemImageSmall">
                                    <img class = "itemImageSmall" src = "/uploads/<%= items[i].imageuuid1%>">
                                </div>
                                <div class = "itemText">
                                    <p class = "itemName" onclick = "document.location.href = '/items/<%= items[i].IID%>'"><%= items[i].title%></p>
                                    <p class = "itemPrice"><%= items[i].price%> €</p>
                                </div>
                            </div>
                            <div class = "divItemPart">
                                <%if(user) {
                                if(currentUser.UID === user.UID) {%>
                                    <button class = "buttonSecondary buttonChangeItem">Change</button>
                                    <button class = "buttonDelete buttonDeleteItem" onclick = "document.location.href = '/items/<%= items[i].IID%>/deleteItem'">Delete</button>
                                <%}}%>
                            </div>
                        </div>
                    <%}%>
                </div>
            </div>
        </div>
    </div>
</div>