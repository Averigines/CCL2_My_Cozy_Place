<%- contentFor('includeStyles') %>
<link rel ="stylesheet" href="/styles/styleRegister.css">

<%- contentFor('body') %>
<div id = "wrapper">
    <div id = "formLogin">
        <h1>Log In</h1>
            <form action = '/login' method = 'post'>
                <div class= 'form_part'>
                    <div class = 'form_element'>
                        <div class = 'form_element_upper'>
                            <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>mail</i>
                            <input type = 'email' name = 'email' placeholder = 'E-Mail address' required="required">
                        </div>
                        <hr>
                    </div>
                    <div class = 'form_element'>
                        <div class = 'form_element_upper'>
                            <i class="material-symbols-outlined" style = 'color:#cbb397; min-width: 32px'>lock</i>
                            <input type = 'password' name = 'password' placeholder = 'Password' required="required">
                        </div>
                        <hr>
                    </div>
                    <p class = "errorMsg"><%= message%></p>
                </div>
                <input id = "submit" type="submit" value="Log In">
            </form>
        </div>
</div>